body {
    margin: 0;
    font-family: Arial;
    background: #f5f7fb;
}

a {
    text-decoration: none;
    color: black;
}

.chat-container {
    display: flex;
    height: 100vh;
}

/* SIDEBAR */
.sidebar {
    width: 250px;
    background: white;
    border-right: 1px solid #ddd;
    padding: 10px;
}

.sidebar a {
    font-weight: bold;
}

.sidebar a:hover {
    color: blue;
}

.user {
    padding: 10px;
    margin: 5px 0;
    border-radius: 10px;
    background: #f0f0f0;
}

/* CHAT BOX */
.chat-box {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.topbar {
    background: white;
    padding: 15px;
    font-weight: bold;
    border-bottom: 1px solid #ddd;
}

/* messages */
.messages {
    flex: 1;
    padding: 15px;
    overflow: auto;
}

.msg {
    display: inline-block;
    max-width: 70%;
    padding: 10px 14px;
    margin: 5px 0;

    border-radius: 12px;
    word-wrap: break-word;
    white-space: pre-wrap;

    font-size: 14px;
    line-height: 1.4;
}

.msg.left {
    background: #f1f1f1;
    color: black;
    align-self: flex-start;
}

.msg.right {
    background: green;
    color: white;
    align-self: flex-end;
}

.messages {
    overflow-y: auto;
    height: 400px;
    scroll-behavior: smooth;
}

.msg {
    padding: 8px 12px;
    margin: 5px;
    border-radius: 10px;
    max-width: 60%;
}

.left {
    background: #e5e5e5;
    align-self: flex-start;
}

.right {
    background: #4f7cff;
    color: white;
    margin-left: auto;
}

/* input */
.input-box {
    display: flex;
    padding: 10px;
    background: white;
    border-top: 1px solid #ddd;
}

.input-box input {
    flex: 1;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 10px;
}

.input-box button {
    margin-left: 10px;
    padding: 10px 20px;
    background: black;
    color: white;
    border: none;
    border-radius: 10px;
    cursor: pointer;
}

#messages {
    display: flex;
    flex-direction: column;
    padding: 10px;
    height: 400px;
    overflow-y: auto;
}

.msg {
    position: relative;
    display: inline-block;
    max-width: 70%;
    padding: 10px 14px;
    margin: 5px 0;
    border-radius: 12px;
    word-wrap: break-word;
}

/* 3 dots button */
.msg-menu-btn {
    position: absolute;
    top: 5px;
    right: 5px;
    cursor: pointer;
    font-size: 18px;
    opacity: 0.6;
}

.msg-menu-btn:hover {
    opacity: 1;
}

/* dropdown menu */
.msg-menu {
    display: none;
    position: absolute;
    right: 0;
    top: 25px;

    background: white;
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    z-index: 10;
}

.msg-menu div {
    padding: 8px 12px;
    cursor: pointer;
    font-size: 13px;
}

.msg-menu div:hover {
    background: #f2f2f2;
}